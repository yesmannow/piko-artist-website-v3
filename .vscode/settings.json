{
  "git.ignoreLimitWarning": true,

  "cSpell.ignorePaths": [
    "**/.next/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/*.min.*",
    "**/public/sw.js",
    "**/public/workbox-*.js"
  ],

  // Skip spell-checking extremely long minified/generated lines
  "cSpell.blockCheckingWhenLineLengthGreaterThan": 20000,

  // Tailwind IntelliSense: reduce "canonical class" warnings
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  "tailwindCSS.lint.recommendedVariantOrder": "ignore",  // Don't nag about order

  // SonarLint: reduce notification noise
  "sonarlint.disableTelemetry": true,
  "sonarlint.showAnalyzerLogs": false,
  "sonarlint.output.showAnalyzerLogs": false

  // Optional: uncomment ONE of these if you want fewer popups
  // "cSpell.showNotifications": false
  // "cSpell.enabledNotifications": { "showNotification": false }
}
