{
  "rules": {
    // ============================================
    // DISABLED - Opinionated Style (Too Noisy)
    // ============================================

    // Prefer Number.parseInt - purely stylistic
    "typescript:S7773": {
      "level": "off"
    },

    // Prefer globalThis over window - we use SSR guards already
    "typescript:S7764": {
      "level": "off"
    },

    // Zero fraction in number (1.0 → 1) - trivial
    "typescript:S7748": {
      "level": "off"
    },

    // Prefer .dataset over setAttribute - stylistic
    "typescript:S7761": {
      "level": "off"
    },

    // Compare with undefined directly - typeof is safer in some cases
    "typescript:S7741": {
      "level": "off"
    },

    // Readonly props - good practice but too noisy during active dev
    "typescript:S6759": {
      "level": "off"
    },

    // Union type with string overriding literals - we use this pattern intentionally
    "typescript:S6571": {
      "level": "off"
    },

    // ============================================
    // ENABLED - High Value (Keep These!)
    // ============================================

    // Cognitive complexity - KEEP but raise threshold
    "typescript:S3776": {
      "level": "on",
      "parameters": {
        "threshold": 25  // Default 15, raised to 25 to reduce noise
      }
    },

    // Context provider value memoization - CRITICAL for performance
    "typescript:S6481": {
      "level": "on"
    },

    // Array index in keys - CRITICAL for React correctness
    "typescript:S6479": {
      "level": "on"
    },

    // aria-hidden on focusable elements - CRITICAL for accessibility
    "typescript:S6825": {
      "level": "on"
    },

    // iframe missing title - CRITICAL for accessibility
    "typescript:S1090": {
      "level": "on"
    },

    // Deprecated symbols - useful to catch library changes
    "typescript:S1874": {
      "level": "on"
    }
  },

  // Optional: reduce noise from node_modules, generated files
  "pathsToExclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js",
    "**/public/sw.js",
    "**/public/workbox-*.js",
    "**/archive/**"
  ]
}
