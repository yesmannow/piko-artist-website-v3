# Piko Artist Website v3 - Environment Variables

# ============================================================
# Service Worker (Production Only)
# ============================================================
# Enable service worker for offline support and caching
# Default: false (only enable in production after testing)
NEXT_PUBLIC_ENABLE_SW=false

# ============================================================
# Phase S8: AI Track Insights
# ============================================================
# Enable track analysis, match scoring, and insights UI
# Default: false (experimental feature, enable for testing)
NEXT_PUBLIC_ENABLE_INSIGHTS=false

# ============================================================
# Cloudflare R2 (Track Storage)
# ============================================================
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=your_bucket_name

# ============================================================
# Supabase (Database & Auth)
# ============================================================
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ============================================================
# Notes
# ============================================================
# - Copy this file to .env.local for local development
# - Never commit .env.local to version control
# - Service Worker should only be enabled in production
# - AI Insights is experimental and disabled by default
