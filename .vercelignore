# Vercel ignore file
# Files and directories to exclude from deployment

# Development files
.env.local
.env.development
.env.test

# Documentation (optional - can be included)
# *.md

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Build outputs
.next/
dist/

# Oversized local assets (breaks Vercel 100MB upload)
public/images/sudio-mixer/
public/images/sudio-mixer/**

