# Vercel ignore file
# Files and directories to exclude from deployment

# Development files
.env.local
.env.development
.env.test

# Documentation (optional - can be included)
# *.md

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Large assets - exclude from Vercel deployment
# These should be served from external CDN or downloaded on-demand
public/models/*.onnx
public/audio/stems/jardin/*.mp3
public/ort/*.wasm

# Model README (documentation, not needed in deployment)
public/models/README.md
