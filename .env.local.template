# Cloudflare R2 Configuration
# Phase V: Data Layer & Audio Streaming

# Your Cloudflare Account ID (found in R2 dashboard)
R2_ACCOUNT_ID=your_account_id

# R2 Access Key ID (create in R2 API Tokens)
R2_ACCESS_KEY_ID=your_access_key

# R2 Secret Access Key (create in R2 API Tokens)
R2_SECRET_ACCESS_KEY=your_secret_key

# R2 Bucket Name (default: piko-media)
R2_BUCKET_NAME=piko-media

# Email Configuration (existing)
# EMAIL_USER=
# EMAIL_PASS=
# RECIPIENT_EMAIL=
