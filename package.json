    "verify:vercel:clean": "node scripts/clean-node-modules.mjs && npm install && npm run verify:vercel",
    "verify:stem-strict": "node scripts/verify-stem-assets-strict.mjs",
    "test:model-url": "node scripts/test-model-url.mjs",
