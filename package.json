{
  "name": "piko-artist-website-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:tracks": "node scripts/check-tracks.js",
    "check:case": "node scripts/check-import-case.mjs",
    "validate:tracks": "node scripts/validate-tracks.js",
    "validate:vercel": "node scripts/validate-vercel-deploy.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "studio:validate": "bash scripts/studio-validate.sh",
    "sync": "node scripts/sync-videos.mjs",
    "audit": "node scripts/audit-repo.mjs",
    "audit:unused": "ts-prune",
    "audit:circular": "madge --circular --extensions ts,tsx src/",
    "audit:complexity": "eslint src/ --ext .ts,.tsx --format json > audit/complexity-report.json",
    "audit:studio": "eslint src/components/studio/ --ext .ts,.tsx",
    "audit:all": "npm run audit:unused && npm run audit:circular && npm run lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@next/third-parties": "^16.1.4",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "@serwist/next": "^9.4.2",
    "@serwist/sw": "^9.4.2",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/nodemailer": "^7.0.4",
    "@use-gesture/react": "^10.3.1",
    "@wavesurfer/react": "^1.0.12",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns-tz": "^3.0.0",
    "detect-gpu": "^5.0.70",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "embla-carousel-react": "^8.6.0",
    "essentia.js": "^0.1.3",
    "framer-motion": "^11.15.0",
    "lenis": "^1.3.16",
    "lucide-react": "^0.460.0",
    "music-metadata": "^11.11.0",
    "next": "15.5.11",
    "nodemailer": "^7.0.12",
    "onnxruntime-web": "^1.23.2",
    "pg": "^8.17.2",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.37.0",
    "rss-parser": "^3.13.0",
    "serwist": "^9.4.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.182.0",
    "tone": "^15.1.22",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.12.1",
    "web-audio-beat-detector": "^8.2.34",
    "zod": "^4.0.17",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^3.0.6",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "puppeteer": "^23.11.1",
    "ts-prune": "^0.10.3",
    "typescript": "5.9.3",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": {
      "esbuild": "^0.25.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,mjs}": [
      "eslint --fix"
    ]
  }
}
